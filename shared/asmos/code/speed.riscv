# How fast is this machine? A loop of four
# instructions runs 250,000 times, a
# million instructions, timed with the
# time service (30), which answers the
# milliseconds since 1970 in a0 (low
# word) and a1 (high word).

    .data
took:   .asciz "1,000,000 instructions in "
ms:     .asciz " ms: "
rate:   .asciz " thousand a second\n"

    .text
main:
    li      a7, 30        # time
    ecall
    mv      s0, a0        # the start
    li      t0, 250000
loop:
    addi    t0, t0, -1
    add     t1, t1, t0
    xor     t2, t2, t1
    bnez    t0, loop
    li      a7, 30
    ecall
    sub     s1, a0, s0    # milliseconds
    la      a0, took
    li      a7, 4
    ecall
    mv      a0, s1
    li      a7, 1
    ecall
    la      a0, ms
    li      a7, 4
    ecall
    li      t0, 1000000   # instructions
    div     a0, t0, s1    # a millisecond
    li      a7, 1
    ecall
    la      a0, rate
    li      a7, 4
    ecall
    li      a7, 10
    ecall
