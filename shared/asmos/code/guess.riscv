# Guess the number: the program picks a
# number from 1 to 100 with the random
# service (42) and reads your guesses
# with read integer (5).

    .data
ask:    .asciz "Your guess (1-100): "
low:    .asciz "Too low.\n"
high:   .asciz "Too high.\n"
right:  .asciz "Right! Guesses: "

    .text
main:
    li      a0, 0         # generator 0
    li      a1, 100       # 0 to 99
    li      a7, 42
    ecall
    addi    s0, a0, 1     # the secret
    li      s1, 0         # guesses
again:
    la      a0, ask
    li      a7, 4
    ecall
    li      a7, 5         # read integer
    ecall
    addi    s1, s1, 1
    blt     a0, s0, too_low
    bgt     a0, s0, too_high
    la      a0, right
    li      a7, 4
    ecall
    mv      a0, s1
    li      a7, 1
    ecall
    li      a0, '\n'
    li      a7, 11
    ecall
    li      a7, 10
    ecall
too_low:
    la      a0, low
    j       say
too_high:
    la      a0, high
say:
    li      a7, 4
    ecall
    j       again
