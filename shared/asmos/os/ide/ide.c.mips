$.str.608:
        .asciz  "ecall runs the service in a7, with a0, a1:\n1 int  4 string  11 char  34 hex\n35 binary  36 unsigned  5 read int\n8 read string (a0 buffer, a1 size)\n12 read char  9 sbrk  10 exit\n93 exit with code a0  32 sleep a0 ms\n30 time (a0 low, a1 high)\n31, 33 MIDI note  40 seed  41 random\n42 random from 0 to a1 - 1"
        .size   $.str.608, 303
        .type   $.str.609,@object
$.str.609:
        .asciz  "Keyboard: the word at 0xffff0000 is 1\nwhen a key waits in 0xffff0004, which\na load takes.\nDisplay: a byte stored at 0xffff000c\nprints in the console.\nBitmap: a comment such as\n# @screen width=64 height=64 base=pic\nshows the words from pic, 0x00RRGGBB."
        .size   $.str.609, 252
        .type   $.str.610,@object
