rndtable:
        .ascii  "\000\bm\334\336\361\225kK\370\376\214\020BJ\025\323/P\362\232\033\315\200\241YM$_nU0\324\214\323\371\026O\3102\034\2744\214\312xD\221>F\270\276[\305\230\340\225h\031\262\374\266\312\266\215\305\004Q\265\362\221*'\343\234\306\341\301\333]z\257\371\000\257\217F\357.\366\2435\243m\250\207\002\353\031\\\024\221\212ME\246N\260\255\324\246q^\241)2\3571o\244F<\002%\253K\210\234\0138*\222\212\345I\222M=b\304\207j?\305\303V`\313qe\252\367\265qP\372l\007\377\355\201\342Okp\246g\361\030\337\357x\306:<R\200\003\270B\217\340\221\340Q\316\243-?Z\250r;!\237_\034\213{b}\304\017F\302\3756\016m\342G\021\241]\272W\364\212\0244{\373\032$\021.4\347\350L\037\335T%\330\245\324j\305\362b+'\257\376\221\276Tv\336\273\210x\243\354\371"
        .size   rndtable, 256
        .type   $.str.321,@object
        .section        .rodata.str1.1,"aMS",@progbits,1
$.str.321:
        .asciz  "are you sure you want to\nquit this great game?"
        .size   $.str.321, 47
        .type   $.str.322,@object
$.str.322:
        .asciz  "please don't leave, there's more\ndemons to toast!"
        .size   $.str.322, 50
        .type   $.str.323,@object
$.str.323:
        .asciz  "let's beat it -- this is turning\ninto a bloodbath!"
        .size   $.str.323, 51
        .type   $.str.324,@object
$.str.324:
        .asciz  "i wouldn't leave if i were you.\ndos is much worse."
        .size   $.str.324, 51
        .type   $.str.325,@object
$.str.325:
        .asciz  "you're trying to say you like dos\nbetter than me, right?"
        .size   $.str.325, 57
        .type   $.str.326,@object
$.str.326:
        .asciz  "don't leave yet -- there's a\ndemon around that corner!"
        .size   $.str.326, 55
        .type   $.str.327,@object
$.str.327:
        .asciz  "ya know, next time you come in here\ni'm gonna toast ya."
        .size   $.str.327, 56
        .type   $.str.328,@object
$.str.328:
        .asciz  "go ahead and leave. see if i care."
        .size   $.str.328, 35
        .type   doom1_endmsg,@object
        .data
        .globl  doom1_endmsg
        .p2align        2, 0x0
doom1_endmsg:
        .4byte  $.str.321
        .4byte  $.str.322
        .4byte  $.str.323
        .4byte  $.str.324
        .4byte  $.str.325
        .4byte  $.str.326
        .4byte  $.str.327
        .4byte  $.str.328
        .size   doom1_endmsg, 32
        .type   $.str.329,@object
        .section        .rodata.str1.1,"aMS",@progbits,1
$.str.329:
        .asciz  "you want to quit?\nthen, thou hast lost an eighth!"
        .size   $.str.329, 50
        .type   $.str.330,@object
$.str.330:
        .asciz  "don't go now, there's a \ndimensional shambler waiting\nat the dos prompt!"
        .size   $.str.330, 73
        .type   $.str.331,@object
$.str.331:
        .asciz  "get outta here and go back\nto your boring programs."
        .size   $.str.331, 52
        .type   $.str.332,@object
$.str.332:
        .asciz  "if i were your boss, i'd \n deathmatch ya in a minute!"
        .size   $.str.332, 54
        .type   $.str.333,@object
$.str.333:
        .asciz  "look, bud. you leave now\nand you forfeit your body count!"
        .size   $.str.333, 58
        .type   $.str.334,@object
$.str.334:
        .asciz  "just leave. when you come\nback, i'll be waiting with a bat."
        .size   $.str.334, 60
        .type   $.str.335,@object
$.str.335:
        .asciz  "you're lucky i don't smack\nyou for thinking about leaving."
        .size   $.str.335, 59
        .type   doom2_endmsg,@object
