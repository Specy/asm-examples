# The trap handler of asmOS on RISC-V, where processes are switched.
#
# Every interrupt and every exception of the program comes here, to the address utvec holds:
#
#   - the timer's interrupt, every 10 ms of running time while applications are ready: the kernel
#     then takes the processor from the process that has had its turn, which is preemption;
#   - the software interrupt a process asks for itself when it gives the processor up,
#     platform_trap below, whose `csrsi uip, 1` the processor answers before the next instruction;
#   - an exception, such as a load from memory that is not there, which ends asmOS with a report.
#
# The processor gets here between two instructions of whatever was running, with uepc saying
# where: the instruction there has not run yet, and `uret` goes back to it. So the handler first
# keeps every register the stopped code may be using in a frame on that code's own stack. Then it
# asks the kernel, in C (switch.c), which process goes on: the C answers a frame, the one it was
# given, or the one another process was stopped with. The handler takes that frame's stack, loads
# the registers back from it, and its `uret` resumes that process where it stopped, as if it had
# never been stopped. A process that has not run yet has a frame made to look the same, whose pc
# is where it starts (platform_context_init).
#
# gp and tp are the same in every process, so the handler leaves them alone. While it runs,
# ustatus's UIE is off, as the processor left it: nothing interrupts it, and an exception in it
# stops the program, as it does before platform_scheduler_start.
#
# This is GNU assembly, the syntax the C beside it compiles to, which names the CSR first:
# `csrw utvec, t0`, where RARS's own syntax writes `csrw t0, utvec`. The Build links this File
# because the kernel calls platform_scheduler_start and platform_trap, which it defines.

        .text

# The frame: the pc in the slot of x0, which needs no keeping, then x1 to x31 at 4 times their
# number, f0 to f31 as doubles from 128, and fcsr at 384. 400 bytes keep sp 16-byte aligned.
# switch.c makes a new process's frame the same way.
        .equ    FRAME, 400

# void platform_scheduler_start(void): installs the handler, and turns interrupts on.
        .globl  platform_scheduler_start
        .p2align 2
platform_scheduler_start:
        la      t0, trap
        csrw    utvec, t0           # where every interrupt and exception goes
        li      t0, 0x11            # in uie, the software interrupt (bit 0) and the timer's (bit 4)
        csrs    uie, t0
        csrsi   ustatus, 1          # UIE: interrupts on, and exceptions to the handler
        ret

# void platform_trap(void): gives the processor up. The software interrupt is taken before the
# `ret`, which runs when this process is switched back to.
        .globl  platform_trap
        .p2align 2
platform_trap:
        csrsi   uip, 1
        ret

        .p2align 2
trap:
        addi    sp, sp, -FRAME
        sw      ra, 4(sp)
        sw      t0, 20(sp)
        sw      t1, 24(sp)
        sw      t2, 28(sp)
        sw      s0, 32(sp)
        sw      s1, 36(sp)
        sw      a0, 40(sp)
        sw      a1, 44(sp)
        sw      a2, 48(sp)
        sw      a3, 52(sp)
        sw      a4, 56(sp)
        sw      a5, 60(sp)
        sw      a6, 64(sp)
        sw      a7, 68(sp)
        sw      s2, 72(sp)
        sw      s3, 76(sp)
        sw      s4, 80(sp)
        sw      s5, 84(sp)
        sw      s6, 88(sp)
        sw      s7, 92(sp)
        sw      s8, 96(sp)
        sw      s9, 100(sp)
        sw      s10, 104(sp)
        sw      s11, 108(sp)
        sw      t3, 112(sp)
        sw      t4, 116(sp)
        sw      t5, 120(sp)
        sw      t6, 124(sp)
        fsd     f0, 128(sp)
        fsd     f1, 136(sp)
        fsd     f2, 144(sp)
        fsd     f3, 152(sp)
        fsd     f4, 160(sp)
        fsd     f5, 168(sp)
        fsd     f6, 176(sp)
        fsd     f7, 184(sp)
        fsd     f8, 192(sp)
        fsd     f9, 200(sp)
        fsd     f10, 208(sp)
        fsd     f11, 216(sp)
        fsd     f12, 224(sp)
        fsd     f13, 232(sp)
        fsd     f14, 240(sp)
        fsd     f15, 248(sp)
        fsd     f16, 256(sp)
        fsd     f17, 264(sp)
        fsd     f18, 272(sp)
        fsd     f19, 280(sp)
        fsd     f20, 288(sp)
        fsd     f21, 296(sp)
        fsd     f22, 304(sp)
        fsd     f23, 312(sp)
        fsd     f24, 320(sp)
        fsd     f25, 328(sp)
        fsd     f26, 336(sp)
        fsd     f27, 344(sp)
        fsd     f28, 352(sp)
        fsd     f29, 360(sp)
        fsd     f30, 368(sp)
        fsd     f31, 376(sp)
        csrr    t0, fcsr            # the rounding mode and the floating-point flags
        sw      t0, 384(sp)
        csrr    t0, uepc            # where the process was stopped
        sw      t0, 0(sp)

        csrr    a0, ucause          # the top bit set for an interrupt, clear for an exception
        bgez    a0, exception
        lw      a1, 0(sp)
        mv      a2, sp
        call    platform_interrupt  # void *platform_interrupt(cause, pc, frame), switch.c
        mv      sp, a0              # the frame of the process that goes on, on its own stack

        lw      t0, 0(sp)
        csrw    uepc, t0
        lw      t0, 384(sp)
        csrw    fcsr, t0
        fld     f0, 128(sp)
        fld     f1, 136(sp)
        fld     f2, 144(sp)
        fld     f3, 152(sp)
        fld     f4, 160(sp)
        fld     f5, 168(sp)
        fld     f6, 176(sp)
        fld     f7, 184(sp)
        fld     f8, 192(sp)
        fld     f9, 200(sp)
        fld     f10, 208(sp)
        fld     f11, 216(sp)
        fld     f12, 224(sp)
        fld     f13, 232(sp)
        fld     f14, 240(sp)
        fld     f15, 248(sp)
        fld     f16, 256(sp)
        fld     f17, 264(sp)
        fld     f18, 272(sp)
        fld     f19, 280(sp)
        fld     f20, 288(sp)
        fld     f21, 296(sp)
        fld     f22, 304(sp)
        fld     f23, 312(sp)
        fld     f24, 320(sp)
        fld     f25, 328(sp)
        fld     f26, 336(sp)
        fld     f27, 344(sp)
        fld     f28, 352(sp)
        fld     f29, 360(sp)
        fld     f30, 368(sp)
        fld     f31, 376(sp)
        lw      ra, 4(sp)
        lw      t1, 24(sp)
        lw      t2, 28(sp)
        lw      s0, 32(sp)
        lw      s1, 36(sp)
        lw      a0, 40(sp)
        lw      a1, 44(sp)
        lw      a2, 48(sp)
        lw      a3, 52(sp)
        lw      a4, 56(sp)
        lw      a5, 60(sp)
        lw      a6, 64(sp)
        lw      a7, 68(sp)
        lw      s2, 72(sp)
        lw      s3, 76(sp)
        lw      s4, 80(sp)
        lw      s5, 84(sp)
        lw      s6, 88(sp)
        lw      s7, 92(sp)
        lw      s8, 96(sp)
        lw      s9, 100(sp)
        lw      s10, 104(sp)
        lw      s11, 108(sp)
        lw      t3, 112(sp)
        lw      t4, 116(sp)
        lw      t5, 120(sp)
        lw      t6, 124(sp)
        lw      t0, 20(sp)
        addi    sp, sp, FRAME
        uret                        # to uepc, with UIE on again

# An exception: what it was, where, and the address or instruction it concerns, for the report.
exception:
        lw      a1, 0(sp)
        csrr    a2, utval
        call    platform_fault      # void platform_fault(cause, pc, value), switch.c: never returns
